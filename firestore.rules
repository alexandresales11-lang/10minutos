rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Execution Logs subcollection
      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(logId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Evidence subcollection
      match /evidence/{evidenceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(evidenceId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(evidenceId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(evidenceId);
      }
    }
  }
}
